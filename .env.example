# This file list all required environment variables for allow app run
# Duplicate it and rename to just `.env` before run the project
# You can either use those example variables or create your own

SERVER_PORT=3000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
DEV_DB_NAME=booking_dev
TEST_DB_NAME=booking_test
DEV_DB_PORT=5432
TEST_DB_PORT=5433

DATABASE_URL="postgresql://postgres:password@localhost:5432/booking_dev"
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5433/booking_test"

# Auth (JWT). Generate a secret with:
# node -p "require('node:crypto').randomBytes(32).toString('hex')"
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# File uploads (max size in bytes, 5 MB)
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Security: allowed CORS origin and max requests per IP per window
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT=100

# Mail (password reset). Free test inbox: https://ethereal.email
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Booking API <no-reply@example.com>"
APP_URL=http://localhost:3000
