# This file list all required environment variables for allow app run
# Duplicate it and rename to just `.env` before run the project
# You can either use those example variables or create your own

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
DEV_DB_NAME=booking_dev
TEST_DB_NAME=booking_test
DEV_DB_PORT=5432
TEST_DB_PORT=5433

DATABASE_URL="postgresql://postgres:password@localhost:5432/booking_dev"
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5433/booking_test"